{
  "name": "zarko-espada-relampago",
  "version": "1.0.0",
  "private": true,
  "description": "Desenho animado retrô (cel animation anos 80/90) em HTML5 Canvas, com exportação para MP4 via Puppeteer + FFmpeg.",
  "type": "module",
  "scripts": {
    "render": "node export/render.mjs",
    "render:hd": "node export/render.mjs --size 1440x1080 --loops 3",
    "render:clean": "node export/render.mjs --no-vhs --out out/zarko-limpo.mp4",
    "render:terror": "node export/render.mjs --page terror/index.html --loops 1 --out out/fita-maldita-333.mp4",
    "render:terror:3x": "node export/render.mjs --page terror/index.html --loops 3 --out out/fita-maldita-333-loop3.mp4",
    "narrar": "python3 scripts/narrar.py",
    "render:parte2": "node export/render.mjs --page terror/parte2.html --loops 1 --out out/fita-maldita-parte2.mp4"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "puppeteer": "^23.11.1"
  }
}
