{
  "name": "zarko-espada-relampago",
  "version": "1.0.0",
  "private": true,
  "description": "Desenho animado retrô (cel animation anos 80/90) em HTML5 Canvas, com exportação para MP4 via Puppeteer + FFmpeg.",
  "type": "module",
  "scripts": {
    "render": "node export/render.mjs",
    "render:hd": "node export/render.mjs --size 1440x1080 --loops 3",
    "render:clean": "node export/render.mjs --no-vhs --out out/zarko-limpo.mp4",
    "render:terror": "node export/render.mjs --page terror/index.html --loops 1 --out out/fita-maldita-333.mp4",
    "render:terror:3x": "node export/render.mjs --page terror/index.html --loops 3 --out out/fita-maldita-333-loop3.mp4",
    "narrar": "python3 scripts/narrar.py",
    "render:parte2": "node export/render.mjs --page terror/parte2.html --loops 1 --out out/fita-maldita-parte2.mp4",
    "render:valenca": "node export/render.mjs --page terror/valenca.html --loops 1 --out out/valenca-parte1.mp4",
    "render:corredor": "node export/render.mjs --page terror/corredor.html --loops 1 --out out/camera-do-corredor.mp4",
    "render:elevador": "node export/render.mjs --page terror/elevador.html --loops 1 --out out/regra-do-elevador.mp4",
    "render:quem": "node export/render.mjs --page terror/quem.html --loops 1 --out out/quem-olha-por-voce.mp4",
    "render:regra316": "node export/render.mjs --page terror/regra316.html --loops 1 --out out/a-regra-das-3h16.mp4",
    "render:valenca2": "node export/render.mjs --page terror/valenca2.html --loops 1 --out out/valenca-parte2.mp4",
    "render:celia": "node export/render.mjs --page terror/celia.html --loops 1 --out out/onze-anos.mp4",
    "render:censo1": "node export/render.mjs --page terror/censo1.html --loops 1 --out out/censo1991-pisadeira.mp4",
    "render:grimorio1": "node export/render.mjs --page terror/grimorio1.html --loops 1 --out out/grimorio-01-ofanim.mp4"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "puppeteer": "^23.11.1"
  }
}
